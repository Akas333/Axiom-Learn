		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@axiom/engine": "*",
		"@hono/node-server": "^1.14.0",
		"@hono/node-ws": "^1.3.1",
		"hono": "^4.7.0"
	},
	"devDependencies": {
		"@types/node": "^24.0.0",
		"tsx": "^4.19.0",
		"typescript": "^5.6.0"
	}
}
