# Secrets for the hosted Kapany server (Modal secret "kapany-secrets").
# Copy to deploy/hosted.env (gitignored), fill in, then:
#   modal secret create kapany-secrets --from-dotenv deploy/hosted.env --force

# ── Supabase (Project Settings → API) ───────────────────────────────────────
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Publishable key (sb_publishable_…) or legacy anon key. Safe for browsers.
SUPABASE_ANON_KEY=
# Secret key (sb_secret_…) or legacy service_role key. Server only: writes plans.
SUPABASE_SECRET_KEY=
# Only for legacy projects that still sign tokens with the shared HS256 secret.
# SUPABASE_JWT_SECRET=

# ── Site ────────────────────────────────────────────────────────────────────
# The public address users open (your Modal URL or custom domain).
KAPANY_SITE_URL=https://YOUR-WORKSPACE--kapany-web.modal.run
# Extra allowed browser origins, comma-separated (optional).
# KAPANY_ORIGINS=https://kapany.app

# ── Free tier: Kapany's own model key and limits ────────────────────────────
META_API_KEY=
# Models new users start on (the Settings → Agent slots), as JSON.
KAPANY_DEFAULT_MODELS={"strong":{"model":{"provider":"meta","id":"muse-spark-1.3"}},"cheap":{"model":{"provider":"meta","id":"muse-spark-1.3"}}}
# Lessons per month on Kapany's keys.
KAPANY_FREE_TURNS=50
KAPANY_PRO_TURNS=2000

# ── Stripe (optional: leave blank to launch without paid plans) ─────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=
