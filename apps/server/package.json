{
	"name": "@axiom/server",
	"version": "0.1.0",
	"description": "Axiom Learn API server: the engine's HTTP surface on Hono (hosted web + desktop).",
	"license": "AGPL-3.0-only",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "tsx watch src/index.ts",
		"start": "tsx src/index.ts",
